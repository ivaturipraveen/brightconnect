[Unit]
Description=Bright Connect chat API (the product the fleet maintains)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=brightconnect
Group=brightconnect
WorkingDirectory=/opt/brightconnect/product/backend
EnvironmentFile=/opt/brightconnect/.env
ExecStart=/opt/brightconnect/product/backend/node_modules/.bin/tsx src/index.ts

Restart=always
RestartSec=3
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=brightconnect-chat

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
