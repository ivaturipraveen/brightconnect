# ============================================================
#  Chat API
#  Values here override the repository-root .env.
#  The Anthropic key is normally set once at the root.
# ============================================================

# Inherited from the root .env unless set here.
# ANTHROPIC_API_KEY=

CHAT_PORT=8080

# Cheapest to most capable: claude-haiku-4-5, claude-sonnet-5, claude-opus-5
CHAT_MODEL=claude-haiku-4-5
CHAT_MAX_TOKENS=4096

# Conversation turns kept before the oldest are dropped.
CHAT_HISTORY_LIMIT=20
