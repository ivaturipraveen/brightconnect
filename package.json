{
  "name": "brightconnect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Brightworks dashboard, and the chat product its agent fleet maintains.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n dash-api,dash-ui,chat-api,chat-ui -c cyan,blue,magenta,green \"npm:dev:dashboard\" \"npm:dev:dashboard-web\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:dashboard": "tsx --env-file-if-exists=.env dashboard/server/index.ts",
    "dev:dashboard-web": "vite --config dashboard/vite.config.ts",
    "dev:backend": "npm run start --prefix product/backend",
    "dev:frontend": "npm run dev --prefix product/frontend",
    "dev:watch": "concurrently -n dash-api,dash-ui -c cyan,blue \"tsx watch --env-file-if-exists=.env dashboard/server/index.ts\" \"npm:dev:dashboard-web\"",
    "build": "vite build --config dashboard/vite.config.ts && npm run build --prefix product/frontend",
    "start": "tsx --env-file-if-exists=.env dashboard/server/index.ts",
    "preflight": "tsx --env-file-if-exists=.env ops/preflight.ts",
    "install:all": "npm install && npm install --prefix product/backend && npm install --prefix product/frontend",
    "typecheck": "tsc --noEmit -p dashboard/tsconfig.json && tsc --noEmit -p dashboard/tsconfig.web.json && npm run typecheck --prefix product/backend && npm run typecheck --prefix product/frontend",
    "test": "npm test --prefix product/backend",
    "clean": "rm -rf dashboard/dist product/frontend/dist workspaces data/*.db data/*.db-shm data/*.db-wal"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@octokit/rest": "^21.1.0",
    "docx": "^9.7.1",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
