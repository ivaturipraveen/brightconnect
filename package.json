{
  "name": "brightconnect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Brightworks - an AI engineering workforce. Agent fleet orchestration for AI-native SDLC and incident response.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:start\" \"npm:dev:web\"",
    "dev:watch": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "clean": "rm -rf dist workspaces data/*.db data/*.db-shm data/*.db-wal"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@octokit/rest": "^21.1.0",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
