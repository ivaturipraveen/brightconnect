# ---- Required: agents cannot run without this ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- GitHub (ticketing + PRs + governance trail) ----
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=your-github-account
GITHUB_REPO=your-repo

# ---- Event intake: GitHub drives the work ------------------
# Work should arrive as events, not as someone clicking "run".
# Webhook:  point GitHub at POST /api/webhooks/github and set the
#           secret below. Needs a public URL (EC2, or ngrok locally).
# Polling:  works anywhere, including localhost. Set to 0 to disable.
GITHUB_WEBHOOK_SECRET=
GITHUB_POLL_SECONDS=45
# Only issues carrying this label are picked up. Leave it set unless
# you want a mission started for every new issue in the repo.
GITHUB_TRIGGER_LABEL=agent-fleet

# ---- Branding (change this one line to rename the product in the UI) ----
PRODUCT_NAME=Bright Connect

# ---- Server ----
PORT=8787
# ---- Database -----------------------------------------------
# Postgres holds missions, the governance trail, approvals and
# the event ledger. Unset it and the platform falls back to a
# local SQLite file, so it still starts with no database.
# A Render internal hostname (dpg-xxxx-a) is completed
# automatically using RENDER_REGION.
DATABASE_URL=
RENDER_REGION=oregon

NODE_ENV=development

# ---- Models ----
# Cheapest -> most capable: claude-haiku-4-5, claude-sonnet-5, claude-opus-5
# Per-agent overrides live in .claude/agents/*.md (model: haiku|sonnet|opus).
ORCHESTRATOR_MODEL=claude-haiku-4-5
AGENT_MODEL=claude-haiku-4-5
