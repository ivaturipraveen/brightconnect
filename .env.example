# ---- Required: agents cannot run without this ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- GitHub (ticketing + PRs + governance trail) ----
GITHUB_TOKEN=github_pat_...
GITHUB_OWNER=ivaturipraveen
GITHUB_REPO=brightconnect

# ---- Branding (change this one line to rename the product in the UI) ----
PRODUCT_NAME=Brightworks
CUSTOMER_NAME=Exol

# ---- Server ----
PORT=8787
NODE_ENV=development

# ---- Models ----
# Cheapest -> most capable: claude-haiku-4-5, claude-sonnet-5, claude-opus-5
# Per-agent overrides live in .claude/agents/*.md (model: haiku|sonnet|opus).
ORCHESTRATOR_MODEL=claude-haiku-4-5
AGENT_MODEL=claude-haiku-4-5
